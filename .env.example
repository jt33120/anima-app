# Copie ce fichier en .env.local et remplis les valeurs (jamais commité).
# En local : lance `supabase start` puis `supabase status` pour récupérer l'URL et les clés.
# Supabase émet désormais des clés « publishable » (publique) et « secret » (serveur).

# Public — exposé au navigateur (préfixe NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SERVEUR uniquement — JAMAIS exposé au client, JAMAIS utilisé sur le contenu utilisateur (AD-12).
# (Cette clé contourne la RLS : réservée aux tâches système et aux tests.)
SUPABASE_SECRET_KEY=sb_secret_...

# Miroir pour les tests RLS
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── IA (Story 2.1) ──────────────────────────────────────────────────────────
# Adaptateur actif. Défaut hors prod = `factice` (aucun réseau, aucune clé) → dev/CI sur données
# synthétiques. `mistral` n'est admis qu'avec la porte ZDR/DPA franchie (voir plus bas).
AI_ADAPTER=factice

# SERVEUR uniquement — clé IA UNIQUE (AD-2). JAMAIS NEXT_PUBLIC_, JAMAIS une clé par utilisatrice.
# En prod Vercel : marquer ce secret « Sensitive ».
MISTRAL_API_KEY=

# Porte pré-lancement art. 9 (AC3) — attestation HUMAINE posée SEULEMENT après signature du
# contrat Mistral (plan Scale). Absente en dev/free : l'adaptateur Mistral refuse alors de démarrer.
MISTRAL_ZDR_CONFIRMED=false
MISTRAL_DPA_SIGNED=false
MISTRAL_PLAN=free

# ── Abonnement Stripe (Story 3.1) ────────────────────────────────────────────
# SERVEUR uniquement — clé secrète Stripe UNIQUE (AD-2). JAMAIS NEXT_PUBLIC_. En prod Vercel :
# marquer « Sensitive ». En dev/test : clé mode test `sk_test_...`.
STRIPE_SECRET_KEY=sk_test_...
# SERVEUR uniquement — secret de signature des webhooks. En local, fourni par `stripe listen`
# (stable entre redémarrages), différent de celui du dashboard. JAMAIS NEXT_PUBLIC_.
STRIPE_WEBHOOK_SECRET=whsec_...
# Libellé de relevé bancaire (AC6) — paramètre neutre, jamais codé en dur. Valeur finale = entité
# juridique (porte pré-lancement). En mode subscription, le libellé EFFECTIF se règle aussi au niveau
# COMPTE Stripe (statement_descriptor_prefix, porte ops).
STRIPE_STATEMENT_DESCRIPTOR=
# Public — clé publishable Stripe (seule autorisée en NEXT_PUBLIC_ ; utilisée par la carte 3.2).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Ordonnanceur unique (Story 4.8) ──────────────────────────────────────────
# SERVEUR uniquement — secret partagé avec Vercel Cron. La porte `/api/ordonnanceur` refuse de servir
# tant qu'il est absent (503) : un ordonnanceur non authentifié est déclenchable par n'importe qui, et
# l'Epic 6 lui confiera la rétention. En prod Vercel : marquer « Sensitive ». Vercel injecte
# automatiquement ce secret dans l'en-tête `Authorization: Bearer` de ses appels Cron.
CRON_SECRET=

# Environnement du DÉPLOIEMENT : local | preview | production. Doit correspondre à ce que la BASE
# déclare (table `environnement`), sinon l'ordonnanceur refuse d'exécuter le moindre job (AC3) — c'est
# ce qui empêche une préversion pointée par erreur sur la prod d'y écrire. Absent ou méconnaissable →
# repli sur `local`, qui ne s'accorde qu'avec une base locale : un oubli ne donne jamais accès à la prod.
ANIMA_ENV=local

# ── Courriel (Story 4.9) ────────────────────────────────────────────────────────────────────────
# Resend est un SOUS-TRAITANT art. 28 : il voit une adresse et un motif, jamais un mot de la
# synthèse (la signature du port l'en empêche — cf. lib/courriel/port.ts). Son DPA est une porte
# pré-lancement, au même titre que celui du fournisseur de modèle.
# Sans ces deux variables, le port répond `estConfigure() === false` : la synthèse est produite et
# consultable, aucune réservation de notification n'est consommée, et rien ne part.
RESEND_API_KEY=
ANIMA_COURRIEL_EXPEDITEUR=anam@exemple.fr

# L'ORIGINE DU DÉPLOIEMENT — porte pré-lancement (revue 4.9, T5-1). Elle porte les DEUX liens du
# courriel : la halte `/synthese` et le désabonnement `/desabonnement`.
#
# Elle était codée en dur à `https://anima.app`, un domaine PARQUÉ et EN VENTE chez un revendeur, relié
# à aucun déploiement. Quiconque l'achète peut servir une fausse page de connexion Anam à des femmes
# qu'un courriel signé « Anam » vient d'avertir qu'un texte intime les attend.
#
# Sans elle, le port répond `estConfigure() === false` : la synthèse est produite et consultable, aucune
# réservation n'est consommée, et rien ne part. `https` obligatoire (sauf localhost), origine SEULE —
# ni chemin, ni requête, ni identifiant dans l'URL.
ANIMA_SITE_URL=http://localhost:3000
