{
  "name": "anima-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "corpus:cahier": "node --experimental-strip-types --import 'data:text/javascript,import{register}from\"node:module\";import{pathToFileURL}from\"node:url\";register(\"./scripts/_alias.mjs\",pathToFileURL(\"./\"));' scripts/gabarit-corpus.mjs > _bmad-output/implementation-artifacts/CAHIER-CORPUS-ANIMA.md"
  },
  "dependencies": {
    "@mistralai/mistralai": "2.5.0",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "astronomy-engine": "2.1.19",
    "next": "16.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "stripe": "22.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "^22.12.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.0",
    "eslint": "9.39.5",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
